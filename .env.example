# docker compose için ortam değişkenleri — .env olarak kopyalayın
ASPNETCORE_ENVIRONMENT=Production
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pati_db
DB_USER=pati_user
DB_PASS=change-me
# En az 32 karakter, rastgele: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=pati-api
JWT_AUDIENCE=pati-mobile
# Google AI Studio'dan ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Yalnızca sunucuda (docker-compose.prod.yml): API'nin internet adresi, örn. pati-api.duckdns.org
API_DOMAIN=
